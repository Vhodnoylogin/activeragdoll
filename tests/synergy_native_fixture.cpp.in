};
#define DYNAMIC_CAST(value,from,to) dynamic_cast<to*>(static_cast<from*>(value))
std::set<const void*> livingBodies;
struct hkpRigidBody {
    hkpRigidBody(){livingBodies.insert(this);}
    ~hkpRigidBody(){livingBodies.erase(this);}
    void Check()const{assert(livingBodies.count(this)&&worldHeld);}
    bool postpone=false;hkpShape* queuedShape=nullptr;
    void setShape(hkpShape* value){Check();if(postpone)queuedShape=value;else collidable.m_shape=value;}
    hkpWorld* world=nullptr;Collidable collidable;NiPoint3 position{},velocity{10,0,0};hkQuaternion rotation;
    hkpWorld* getWorld(){Check();return world;}Collidable* getCollidable(){return &collidable;}
    NiPoint3 getPosition(){Check();return position;}hkQuaternion getRotation(){Check();return rotation;}
    NiPoint3 getLinearVelocity(){return velocity;}float getMassInv(){return .1f;}
};
