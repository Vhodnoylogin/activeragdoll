    /*@CLUTTER_HIT@*/
};
void PLANCK_CALL Deny(const PlanckHitSnapshot*,PlanckHitDecision* d,void*){d->deny=1;}
void PLANCK_CALL Reduce(const PlanckHitSnapshot*,PlanckHitDecision* d,void*){d->damageScale=.25f;}
