struct hkaRagdollInstance {
    hkpWorld* world=nullptr;Skeleton* m_skeleton=nullptr;EngineArray<hkpRigidBody*> m_rigidBodies;
    EngineArray<int> boneToBody;
    int getBoneIndexOfRigidBody(hkpRigidBody* body) const {
        for (int i=0; i<boneToBody.getSize(); ++i) {
            if (boneToBody[i]>=0 && m_rigidBodies[boneToBody[i]]==body) return i;
        }
        return -1;
    }
    hkpWorld* getWorld(){assert(graphHeld&&worldHeld&&!m_rigidBodies.empty());return world;}
};
