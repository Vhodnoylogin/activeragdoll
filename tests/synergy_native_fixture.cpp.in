    PublishSynergyActor(&target);resolvedActor=&target;
    PlanckSynergy::InstallNativeEndpointResolver(ResolveSynergyEndpoint);
    PlanckActorPhysics a{sizeof(a)};PlanckBodyPhysics b{sizeof(b)};uint32_t needed=0;
    assert(api->CopyActorPhysics(client,42,&a,&b,1,&needed)==PLANCK_OK);
    assert(std::strcmp(b.boneName,"NPC Pelvis")==0 && a.observedAtNs>0);
    PlanckEndpointQuery query{sizeof(query),0,b.body,{0,0,.2f},0};PlanckEndpoint endpoint{sizeof(endpoint)};
    assert(api->AcquireAttachmentEndpoint(client,&query,&endpoint)==PLANCK_OK);
    auto visit=+[](const PlanckNativeEndpoint* n,void* p)->PlanckStatus{
        assert(graphHeld&&worldHeld&&n->rigidBody==reinterpret_cast<uintptr_t>(p)&&n->endpoint.localPoint.z==.2f);
        return PLANCK_OK;
    };
    fakeThread=2;assert(PlanckSynergy::GetPhysicalInteropAPI()->WithAttachmentEndpoint(client,endpoint.lease,visit,live)==PLANCK_BUSY);fakeThread=1;
    assert(PlanckSynergy::GetPhysicalInteropAPI()->WithAttachmentEndpoint(client,endpoint.lease,visit,live)==PLANCK_OK);
    PlanckGeometryRequest g{sizeof(g),0,b.body,b.geometryRevision,{0,0,0},{0,0,.7f},.15f,0};PlanckToken request=0;
    assert(api->RequestActorGeometry(client,&g,&request)==PLANCK_OK);
    world.critical=1;PublishSynergyActor(&target);
    PlanckRequestResult result{sizeof(result)};assert(api->GetRequestResult(client,request,&result)==PLANCK_OK&&result.stage==PLANCK_REQUEST_ACCEPTED);
    assert(shape.m_radius==.1f);world.critical=0;live->postpone=true;PublishSynergyActor(&target);
    assert(api->CancelRequest(client,request)==PLANCK_BUSY&&live->queuedShape);
    assert(shape.m_radius==.1f);live->collidable.m_shape=live->queuedShape;live->queuedShape=nullptr;live->postpone=false;
    PublishSynergyActor(&target);assert(api->GetRequestResult(client,request,&result)==PLANCK_OK&&result.stage==PLANCK_REQUEST_COMPLETED&&result.geometryRevision==2);
    auto* adopted=dynamic_cast<hkpCapsuleShape*>(live->collidable.m_shape);assert(adopted&&adopted!=&shape&&adopted->m_radius==.15f&&shape.m_radius==.1f);
    assert(adopted->getVertex(1).z==.7f&&shape.getVertex(1).z==.5f);
