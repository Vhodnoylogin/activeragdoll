struct hkpShape {
    virtual ~hkpShape()=default;uintptr_t m_userData=0;mutable int references=2;
    void addReference()const{++references;}void removeReference()const{assert(references>0);--references;}
};
struct hkpCapsuleShape:hkpShape {
    struct Vertex {float x,y,z,w;operator NiPoint3()const{return {x,y,z};}float operator()(int index)const{return index==0?x:index==1?y:z;}};
    float m_radius=.1f;Vertex vertices[2]{{0,0,0,.1f},{0,0,.5f,.1f}};
    int getReferenceCount()const{return references;}
    Vertex getVertex(int i)const{return vertices[i];}
    void setVertex(int i,NiPoint3 v){vertices[i]={v.x,v.y,v.z,m_radius};}
};
struct hkpListShape:hkpShape {
    struct ChildInfo {const hkpShape* m_shape=nullptr;uint32_t m_collisionFilterInfo=0;int m_shapeSize=64,m_numChildShapes=1;};
    EngineArray<ChildInfo> m_childInfo;uint16_t m_flags=3,m_numDisabledChildren=0;
    NiPoint3 m_aabbCenter{},m_aabbHalfExtents{};uint32_t m_enabledChildren[8]{~0u,~0u,~0u,~0u,~0u,~0u,~0u,~0u};
    int isChildEnabled(int index)const{return m_enabledChildren[index>>5]&(1u<<(index&31));}
};
