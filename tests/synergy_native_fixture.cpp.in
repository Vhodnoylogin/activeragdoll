    assert(api->CopyActorPhysics(client,42,&a,&b,1,&needed)==PLANCK_OK);
    PlanckBodyGeometry geometry{sizeof(geometry)};PlanckShapeChild children[2]{};for(auto& child:children)child.size=sizeof(child);
    assert(compound->CopyBodyGeometry(client,b.body,&geometry,nullptr,0,&needed)==PLANCK_BUFFER&&needed==2);
    assert(compound->CopyBodyGeometry(client,b.body,&geometry,children,2,&needed)==PLANCK_OK&&geometry.geometryRevision==1&&geometry.shapeKind==PLANCK_SHAPE_LIST);
    assert(children[0].enabled&&children[0].collisionFilter==33&&!children[1].enabled&&children[1].collisionFilter==55);
    PlanckCompoundProposal proposal{sizeof(proposal),2,b.body,geometry.geometryRevision,0};
    PlanckCapsuleEdit edits[2]{{sizeof(PlanckCapsuleEdit),0,{0,0,0},{0,0,1.5f},.2f,0},{sizeof(PlanckCapsuleEdit),1,{0,0,0},{0,0,2.5f},.3f,0}};
    auto malformed=proposal;malformed.reserved=1;assert(compound->RequestCapsuleEdits(client,&malformed,edits,&request)==PLANCK_INVALID);
    auto duplicate=edits[1];edits[1].index=0;assert(compound->RequestCapsuleEdits(client,&proposal,edits,&request)==PLANCK_INVALID);edits[1]=duplicate;
    malformed=proposal;--malformed.expectedRevision;assert(compound->RequestCapsuleEdits(client,&malformed,edits,&request)==PLANCK_INVALID);
    assert(compound->RequestCapsuleEdits(client,&proposal,edits,&request)==PLANCK_OK);PlanckToken rejected=999;
    assert(compound->RequestCapsuleEdits(other,&proposal,edits,&rejected)==PLANCK_CONFLICT&&rejected==0);
    world.critical=1;PublishSynergyActor(&target);assert(listBody->collidable.m_shape==&sourceList);world.critical=0;
    listBody->postpone=true;PublishSynergyActor(&target);assert(listBody->queuedShape&&listBody->collidable.m_shape==&sourceList);
