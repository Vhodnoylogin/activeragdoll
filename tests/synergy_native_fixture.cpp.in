    ragdoll.boneToBody.push_back(-1);ragdoll.boneToBody.push_back(0);
    hkbRagdollDriver driver{&ragdoll};BShkbAnimationGraph graph;graph.character.ragdollDriver=&driver;fakeManager.graphs.data[0].ptr=&graph;
    unsigned published=0;PlanckToken subscription=0;
