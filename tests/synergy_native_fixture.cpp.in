struct NiCloningProcess {};
bool cloneSharesRoot=false,cloneSharesCapsule=false;
bhkShape* NiObject_Clone(bhkShape* source,NiCloningProcess*){
    auto* old=dynamic_cast<hkpCapsuleShape*>(source->shape.val());
    hkpShape* copy=nullptr;
    if(old)copy=cloneSharesCapsule?old:new hkpCapsuleShape(*old);
    else{
        auto* list=dynamic_cast<hkpListShape*>(source->shape.val());assert(list);
        if(cloneSharesRoot)return new bhkShape{{list}};
        auto* cloned=new hkpListShape(*list);for(const auto& child:cloned->m_childInfo)if(child.m_shape)child.m_shape->addReference();copy=cloned;
    }
    auto* wrapper=new bhkShape{{copy}};
    if(cloneSharesCapsule)return wrapper; // An invalid clone must not change the original's back-pointer.
    copy->m_userData=reinterpret_cast<uintptr_t>(wrapper);return wrapper;
}
