        assert(api->GetRequestResult(other,request,&result)==PLANCK_OK&&result.stage==PLANCK_REQUEST_COMPLETED);
        assert(!adoptedList->m_userData&&!adoptedList->m_childInfo[0].m_shape->m_userData&&!adoptedList->m_childInfo[1].m_shape->m_userData);
        assert(api->ReleaseLease(other,request)==PLANCK_OK);
    }
    // A late unsupported child refuses the complete batch after preparing the
    // first private child: no root, authored geometry or retained owner changes.
    hkpShape unsupported;sourceList.m_childInfo[1].m_shape=&unsupported;listBody->collidable.m_shape=&sourceList;PublishSynergyActor(&target);
    assert(api->CopyActorPhysics(other,42,&a,&b,1,&needed)==PLANCK_OK);
    proposal.body=b.body;proposal.expectedRevision=b.geometryRevision;proposal.editCount=1;
    assert(compound->RequestCapsuleEdits(other,&proposal,edits,&request)==PLANCK_OK);PublishSynergyActor(&target);
    assert(api->GetRequestResult(other,request,&result)==PLANCK_OK&&result.stage==PLANCK_REQUEST_REJECTED&&result.status==PLANCK_UNSUPPORTED);
    assert(listBody->collidable.m_shape==&sourceList&&sourceList.m_childInfo[0].m_shape==&childA&&childA.m_radius==.1f&&sourceList.m_childInfo[1].m_shape==&unsupported);
    assert(api->ReleaseLease(other,request)==PLANCK_OK);
    PlanckSynergy::InvalidateBody(reinterpret_cast<uintptr_t>(listBody));RetireSynergyGeometry(reinterpret_cast<uintptr_t>(listBody));
    assert(!adoptedList->m_userData&&!adoptedList->m_childInfo[0].m_shape->m_userData&&!adoptedList->m_childInfo[1].m_shape->m_userData);
    delete listBody;ragdoll.m_rigidBodies.clear();assert(api->ReleaseClient(other)==PLANCK_OK);
    std::cout<<"PASS actual-source clutter, scoped endpoints, direct/compound clone adoption, revisions, deferred/closing ownership, alias/partial refusal, disabled/filter/AABB preservation and all wrapper retirement paths\n";

}
